# 1. Secrets
# Never commit your API keys or other secrets
.env
Final/Evaluation/.env

# 2. Virtual Environments
# Ignore all virtual environment folders (we've used a few!)
/.venv
/.venv2
/.venv_eval

# 3. Generated Data (Your Vector Store)
# This database is built by your script and should not be in Git.
/data/chroma_db/
Final/Chroma-db


# 4. Evaluation Outputs
# Ignore the CSV reports generated by evaluation script.
# ragas_*.csv

# 5. Python Caches
# Standard Python cache files
__pycache__/
*.pyc

# 6. IDE Folders
# Ignores settings for VS Code and PyCharm
/.vscode/
/.idea/

# 7. Mac OS Files
# Standard Mac system file
.DS_Store

